{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumericalMethodRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "numerical_structure",
    "interpretation",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["time_step_method", "discretization", "solver_tolerance", "convergence_diagnostic", "stability_diagnostic", "state_constraint", "validation_diagnostic"]
    },
    "numerical_structure": {"type": "string"},
    "interpretation": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABMModelRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "rule_or_structure",
    "interpretation",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["agent_state", "behavior_rule", "interaction_structure", "environment", "schedule", "simulation_protocol", "validation_diagnostic", "emergence_diagnostic"]
    },
    "rule_or_structure": {"type": "string"},
    "interpretation": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

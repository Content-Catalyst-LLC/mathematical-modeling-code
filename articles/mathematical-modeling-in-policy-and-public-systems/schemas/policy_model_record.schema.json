{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyModelRecord",
  "type": "object",
  "required": [
    "key",
    "policy_domain",
    "model_role",
    "model_family",
    "public_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "policy_domain": {"type": "string"},
    "model_role": {
      "type": "string",
      "enum": ["problem_framing", "forecasting", "option_comparison", "distributional_review", "model_governance", "public_communication"]
    },
    "model_family": {"type": "string"},
    "public_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

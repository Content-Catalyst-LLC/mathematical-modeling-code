{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpatialModelRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "geometry_or_structure",
    "interpretation",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["geometry", "coordinate_system", "distance_metric", "accessibility_metric", "neighborhood_rule", "spatial_field", "validation_diagnostic", "network_boundary"]
    },
    "geometry_or_structure": {"type": "string"},
    "interpretation": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

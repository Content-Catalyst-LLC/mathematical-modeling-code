{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DynamicModelRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "expression",
    "interpretation",
    "units_or_domain",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["state_variable", "rate_equation", "initial_condition", "boundary_condition", "parameter", "numerical_setting", "output_diagnostic"]
    },
    "expression": {"type": "string"},
    "interpretation": {"type": "string"},
    "units_or_domain": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

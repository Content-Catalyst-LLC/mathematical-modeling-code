{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetworkEdge",
  "type": "object",
  "required": [
    "source",
    "target",
    "relationship",
    "weight",
    "evidence_quality"
  ],
  "properties": {
    "source": {"type": "string"},
    "target": {"type": "string"},
    "relationship": {"type": "string"},
    "weight": {"type": "number", "minimum": 0},
    "evidence_quality": {"type": "string", "enum": ["high", "medium", "low"]}
  }
}

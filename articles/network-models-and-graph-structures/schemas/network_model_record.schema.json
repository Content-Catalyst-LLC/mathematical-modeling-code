{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetworkModelRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "expression_or_structure",
    "interpretation",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["node", "edge", "edge_weight", "direction_rule", "diagnostic", "process_rule", "validation_diagnostic", "network_boundary"]
    },
    "expression_or_structure": {"type": "string"},
    "interpretation": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

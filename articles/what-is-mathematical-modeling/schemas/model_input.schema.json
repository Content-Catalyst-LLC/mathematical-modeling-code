{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogisticModelInput",
  "type": "object",
  "required": ["name", "initial_state", "growth_rate", "carrying_capacity", "time_step", "steps"],
  "properties": {
    "name": {"type": "string"},
    "initial_state": {"type": "number", "minimum": 0},
    "growth_rate": {"type": "number"},
    "carrying_capacity": {"type": "number", "exclusiveMinimum": 0},
    "time_step": {"type": "number", "exclusiveMinimum": 0},
    "steps": {"type": "integer", "minimum": 1}
  }
}

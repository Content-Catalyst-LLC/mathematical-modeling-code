{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalculusArticleRecord",
  "type": "object",
  "required": ["slug", "title", "status", "folder"],
  "properties": {
    "slug": {"type": "string"},
    "title": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "planned", "review", "revise", "archive"]},
    "folder": {"type": "string"}
  }
}

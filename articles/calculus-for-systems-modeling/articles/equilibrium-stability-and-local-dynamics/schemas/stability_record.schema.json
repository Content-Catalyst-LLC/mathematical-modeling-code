{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StabilityRecord",
  "type": "object",
  "required": [
    "scenario", "equilibrium", "derivative_value", "stability",
    "domain_min", "domain_max", "warning"
  ],
  "properties": {
    "scenario": {"type": "string"},

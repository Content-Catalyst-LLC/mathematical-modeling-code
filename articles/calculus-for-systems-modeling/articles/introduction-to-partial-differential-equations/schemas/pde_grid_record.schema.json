{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDEGridRecord",
  "type": "object",
  "required": [
    "step", "time", "center_value", "total_mass",
    "max_value", "min_value", "stability_ratio", "warning"
  ],
  "properties": {
    "step": {"type": "integer"},
    "time": {"type": "number"},
    "center_value": {"type": "number"},
    "total_mass": {"type": "number"},
    "max_value": {"type": "number"},
    "min_value": {"type": "number"},
    "stability_ratio": {"type": "number"},
    "warning": {"type": "string"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoupledSystemRecord",
  "type": "object",
  "required": [
    "scenario", "time", "prey", "predator", "prey_rate", "predator_rate",
    "alpha", "beta", "delta", "gamma", "method", "warning"
  ],
  "properties": {
    "scenario": {"type": "string"},
    "time": {"type": "number"},
    "prey": {"type": "number"},
    "predator": {"type": "number"},
    "prey_rate": {"type": "number"},
    "predator_rate": {"type": "number"},
    "alpha": {"type": "number"},
    "beta": {"type": "number"},
    "delta": {"type": "number"},
    "gamma": {"type": "number"},
    "method": {"type": "string"},
    "warning": {"type": "string"}
  }
}

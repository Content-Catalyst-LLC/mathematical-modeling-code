    "growth_rate": {"type": "number"},
    "carrying_capacity": {"type": "number"},
    "initial_stock": {"type": "number"},
    "time_step": {"type": "number"},
    "horizon": {"type": "number"},
    "final_time": {"type": "number"},
    "final_stock": {"type": "number"},
    "interpretation_warning": {"type": "string"}
  }
}

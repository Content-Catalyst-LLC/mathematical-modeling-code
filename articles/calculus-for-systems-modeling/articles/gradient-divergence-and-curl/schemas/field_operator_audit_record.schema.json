    "grid_step": {"type": "number"},
    "point_count": {"type": "integer"},
    "mean_gradient_magnitude": {"type": "number"},
    "maximum_gradient_magnitude": {"type": "number"},
    "mean_divergence": {"type": "number"},
    "mean_curl": {"type": "number"},
    "maximum_abs_curl": {"type": "number"},

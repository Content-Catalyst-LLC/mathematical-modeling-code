{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OscillationRecord",
  "type": "object",
  "required": [
    "scenario", "time", "position", "velocity", "acceleration",
    "damping_ratio", "natural_frequency", "forcing", "method", "warning"
  ],
  "properties": {
    "scenario": {"type": "string"},
    "time": {"type": "number"},
    "position": {"type": "number"},
    "velocity": {"type": "number"},
    "acceleration": {"type": "number"},
    "damping_ratio": {"type": "number"},
    "natural_frequency": {"type": "number"},
    "forcing": {"type": "number"},
    "method": {"type": "string"},
    "warning": {"type": "string"}
  }
}

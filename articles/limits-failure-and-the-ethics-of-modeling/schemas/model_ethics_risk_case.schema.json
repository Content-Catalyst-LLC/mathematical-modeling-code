{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelRiskCase",
  "type": "object",
  "required": [
    "key",
    "model_name",
    "intended_use",
    "severity",
    "likelihood",
    "detectability_gap",
    "uncertainty_level",
    "equity_concern",
    "accountability_gap"
  ],
  "properties": {
    "key": {"type": "string"},
    "model_name": {"type": "string"},
    "intended_use": {"type": "string"},
    "severity": {"type": "number", "minimum": 0, "maximum": 1},
    "likelihood": {"type": "number", "minimum": 0, "maximum": 1},
    "detectability_gap": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_level": {"type": "number", "minimum": 0, "maximum": 1},
    "equity_concern": {"type": "number", "minimum": 0, "maximum": 1},
    "accountability_gap": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

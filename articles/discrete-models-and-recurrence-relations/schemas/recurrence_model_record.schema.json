{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecurrenceModelRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "expression",
    "interpretation",
    "domain_or_step",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["state_variable", "update_rule", "initial_condition", "boundary_rule", "parameter", "output_diagnostic", "step_definition"]
    },
    "expression": {"type": "string"},
    "interpretation": {"type": "string"},
    "domain_or_step": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

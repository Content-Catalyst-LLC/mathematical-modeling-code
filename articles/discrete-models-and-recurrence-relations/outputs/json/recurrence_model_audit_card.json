    {
      "component_type": "state_variable",
      "domain_or_step": "0 <= S_t <= K",
      "expression": "S_t",
      "interpretation": "Current resource storage at period t",
      "key": "storage",
      "recurrence_risk_score": 1.0,
      "review_question": "Is storage directly observed and bounded?",
      "status": "active"
    },
    {
      "component_type": "update_rule",
      "domain_or_step": "one_period",
      "expression": "S[t+1] = min(K max(0 S[t] + I[t] - D[t] - lambda*S[t]))",
      "interpretation": "Storage updates through inflow demand and proportional loss",
      "key": "storage_update",
      "recurrence_risk_score": 3.0,
      "review_question": "Are boundary events reported rather than hidden by clipping?",
      "status": "active"
    },
    {
      "component_type": "update_rule",
      "domain_or_step": "one_period",
      "expression": "D[t+1] = max(0 D[t] - alpha*Q[t])",
      "interpretation": "Demand adapts after shortage",
      "key": "demand_update",
      "recurrence_risk_score": 6.0,
      "review_question": "Is demand truly adaptive or should it be external input?",
      "status": "review"
    },
    {
      "component_type": "initial_condition",
      "domain_or_step": "0 <= S_0 <= K",
      "expression": "S_0",
      "interpretation": "Starting storage",
      "key": "initial_storage",
      "recurrence_risk_score": 5.0,
      "review_question": "How was the starting state measured?",
      "status": "review"
    },
    {
      "component_type": "output_diagnostic",
      "domain_or_step": "reported_each_period",
      "expression": "Q[t] = max(0 -raw_next_storage)",
      "interpretation": "Unmet demand before boundary clipping",
      "key": "shortage",
      "recurrence_risk_score": 6.0,
      "review_question": "Is shortage accumulated reported or clipped away?",
      "status": "review"
    },
    {
      "component_type": "step_definition",
      "domain_or_step": "period_or_iteration",
      "expression": "t_to_t_plus_1",
      "interpretation": "One discrete update interval",
      "key": "step_definition",
      "recurrence_risk_score": 6.0,
      "review_question": "What does one step represent?",
      "status": "review"
    }
  ],

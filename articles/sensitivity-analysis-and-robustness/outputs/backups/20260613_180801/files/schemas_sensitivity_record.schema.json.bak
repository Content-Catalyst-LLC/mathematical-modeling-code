{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SensitivityRecord",
  "type": "object",
  "required": [
    "key",
    "sensitivity_layer",
    "modeling_role",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "sensitivity_layer": {
      "type": "string",
      "enum": ["local_sensitivity", "global_sensitivity", "robustness", "decision_support", "model_form", "data_quality", "governance"]
    },
    "modeling_role": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UncertaintyRecord",
  "type": "object",
  "required": [
    "key",
    "uncertainty_layer",
    "modeling_role",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "uncertainty_layer": {
      "type": "string",
      "enum": ["data", "parameter", "model_form", "scenario", "aleatory", "decision_support", "governance"]
    },
    "modeling_role": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

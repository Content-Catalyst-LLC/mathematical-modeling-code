{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpidemicScenario",
  "type": "object",
  "required": [
    "key",
    "scenario_name",
    "population",
    "initial_infectious",
    "initial_recovered",
    "beta",
    "gamma",
    "days",
    "hospital_capacity",
    "hospitalization_rate"
  ],
  "properties": {
    "key": {"type": "string"},
    "scenario_name": {"type": "string"},
    "population": {"type": "number"},
    "initial_infectious": {"type": "number"},
    "initial_recovered": {"type": "number"},
    "beta": {"type": "number"},
    "gamma": {"type": "number"},
    "days": {"type": "integer"},
    "hospital_capacity": {"type": "number"},
    "hospitalization_rate": {"type": "number"}
  }
}

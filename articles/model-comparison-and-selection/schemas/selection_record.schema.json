{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelectionRecord",
  "type": "object",
  "required": [
    "key",
    "selection_layer",
    "modeling_role",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "selection_layer": {
      "type": "string",
      "enum": ["alternatives", "generalization", "parsimony", "communication", "uncertainty", "decision_support"]
    },
    "modeling_role": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticRecord",
  "type": "object",
  "required": [
    "key",
    "diagnostic_layer",
    "modeling_role",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "diagnostic_layer": {
      "type": "string",
      "enum": ["bias", "decision_support", "subgroup", "tail_error", "model_form", "uncertainty", "governance"]
    },
    "modeling_role": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

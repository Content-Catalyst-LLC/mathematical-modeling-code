{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RobustnessRecord",
  "type": "object",
  "required": [
    "key",
    "dependence_layer",
    "modeling_role",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "dependence_layer": {
      "type": "string",
      "enum": ["parameter", "model_form", "scenario", "decision_threshold", "data", "metric", "governance"]
    },
    "modeling_role": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

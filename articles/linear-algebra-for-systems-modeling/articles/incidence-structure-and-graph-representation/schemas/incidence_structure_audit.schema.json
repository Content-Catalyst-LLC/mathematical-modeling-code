{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidenceStructureAudit",
  "type": "object",
  "required": [
    "graph_name",
    "node_count",
    "edge_count",
    "directed_convention",
    "signed_incidence",
    "nonzero_incidence_entries",
    "incidence_density",
    "max_absolute_node_balance",
    "laplacian_trace",
    "rank_estimate",
    "flow_conservation_warning",
    "representation_warning"
  ],
  "properties": {
    "graph_name": {
      "type": "string"
    },
    "node_count": {
      "type": "integer"
    },
    "edge_count": {
      "type": "integer"
    },
    "directed_convention": {
      "type": "string"
    },
    "signed_incidence": {
      "type": "boolean"
    },
    "nonzero_incidence_entries": {
      "type": "integer"
    },
    "incidence_density": {
      "type": "number"
    },
    "max_absolute_node_balance": {
      "type": "number"
    },
    "laplacian_trace": {
      "type": "number"
    },
    "rank_estimate": {
      "type": "integer"
    },
    "flow_conservation_warning": {
      "type": "string"
    },
    "representation_warning": {
      "type": "string"
    }
  }
}
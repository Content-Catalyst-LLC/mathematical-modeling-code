{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptimizationModelRecord",
  "type": "object",
  "required": [
    "key",
    "component_type",
    "expression",
    "interpretation",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "component_type": {
      "type": "string",
      "enum": ["decision_variable", "objective_function", "constraint", "parameter", "feasible_region", "solver_setting", "validation_diagnostic"]
    },
    "expression": {"type": "string"},
    "interpretation": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StructuralRecord",
  "type": "object",
  "required": [
    "key",
    "structural_layer",
    "modeling_role",
    "review_question",
    "status"
  ],
  "properties": {
    "key": {"type": "string"},
    "structural_layer": {
      "type": "string",
      "enum": ["model_family", "relationship", "boundary", "aggregation", "scale", "regime", "governance"]
    },
    "modeling_role": {"type": "string"},
    "review_question": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "review", "revise", "archive"]}
  }
}

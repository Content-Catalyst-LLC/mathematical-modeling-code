{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelGovernanceRecord",
  "type": "object",
  "required": [
    "key",
    "model_name",
    "model_purpose",
    "risk_tier",
    "validation_status",
    "use_limit_status",
    "monitoring_status",
    "model_owner",
    "decision_owner"
  ],
  "properties": {
    "key": {"type": "string"},
    "model_name": {"type": "string"},
    "model_purpose": {"type": "string"},
    "risk_tier": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "validation_status": {"type": "string"},
    "use_limit_status": {"type": "string"},
    "monitoring_status": {"type": "string"},
    "model_owner": {"type": "string"},
    "decision_owner": {"type": "string"}
  }
}

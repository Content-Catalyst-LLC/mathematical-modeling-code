  "fields": [
    {"name": "model_id", "type": "integer"},
    {"name": "model_name", "type": "string"},
    {"name": "model_family", "type": "string"},
    {"name": "state_variable", "type": "string"},
    {"name": "parameter_name", "type": "string"},
    {"name": "parameter_value", "type": "number"},
    {"name": "initial_condition", "type": "number"},
